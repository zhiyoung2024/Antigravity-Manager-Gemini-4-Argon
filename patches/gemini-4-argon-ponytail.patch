+        let rest = &lower[idx + "gemini-".len()..];
+        let version_part: String = rest
+            .chars()
+            .take_while(|c| c.is_ascii_digit() || *c == '.')
+            .collect();
+        if let Ok(ver) = version_part.parse::<f32>() {
+            return ver >= 4.0;
+        }
+    }
