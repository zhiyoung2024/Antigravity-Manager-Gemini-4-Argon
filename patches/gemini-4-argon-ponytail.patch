+pub fn is_gemini_v4_or_above(model: &str) -> bool {
+    if crate::utils::ponytail::is_argon_model(model) {
+        return true;
+    }
+    let lower = model.to_lowercase();
+    if !lower.contains("gemini") {
+        return false;
+    }
